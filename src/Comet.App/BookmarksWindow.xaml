<Window x:Class="Comet.App.BookmarksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="0,0,0,8" />
        <Button x:Name="OpenButton" DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="12,6" HorizontalAlignment="Right" Click="Open_Click">Open</Button>
        <ListBox x:Name="BookmarkList" MouseDoubleClick="BookmarkList_MouseDoubleClick" />
    </DockPanel>
</Window>
