<Window x:Class="Comet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Comet.App.Controls"
        Title="Comet" Width="1200" Height="850" MinWidth="640" MinHeight="480"
        WindowState="Maximized"
        Background="Black" AllowDrop="True"
        PreviewKeyDown="Window_KeyDown" PreviewMouseWheel="Window_PreviewMouseWheel"
        DpiChanged="Window_DpiChanged" Drop="Window_Drop">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem x:Name="FileMenu">
                <MenuItem x:Name="OpenMenuItem" InputGestureText="Ctrl+O" Click="Open_Click" />
                <MenuItem x:Name="OpenFolderMenuItem" Click="OpenFolder_Click" />
                <Separator />
                <MenuItem x:Name="CloseBookMenuItem" InputGestureText="Ctrl+W" Click="CloseBook_Click" />
                <Separator />
                <MenuItem x:Name="ExitMenuItem" InputGestureText="Ctrl+Q" Click="Exit_Click" />
            </MenuItem>
            <MenuItem x:Name="NavigateMenu">
                <MenuItem x:Name="PreviousPageMenuItem" InputGestureText="PageUp" Click="Previous_Click" />
                <MenuItem x:Name="NextPageMenuItem" InputGestureText="PageDown" Click="Next_Click" />
                <Separator />
                <MenuItem x:Name="PreviousArchiveMenuItem" InputGestureText="Ctrl+Shift+P" Click="PreviousArchive_Click" />
                <MenuItem x:Name="NextArchiveMenuItem" InputGestureText="Ctrl+Shift+N" Click="NextArchive_Click" />
            </MenuItem>
            <MenuItem x:Name="ViewMenu">
                <MenuItem x:Name="BestFitMenuItem" IsCheckable="True" InputGestureText="B" Click="BestFit_Click" />
                <MenuItem x:Name="FitWidthMenuItem" IsCheckable="True" InputGestureText="W" Click="FitWidth_Click" />
                <MenuItem x:Name="FitHeightMenuItem" IsCheckable="True" InputGestureText="H" Click="FitHeight_Click" />
                <MenuItem x:Name="ManualMenuItem" IsCheckable="True" InputGestureText="A" Click="Manual_Click" />
                <MenuItem x:Name="FixedSizeMenuItem" IsCheckable="True" InputGestureText="S" Header="Fixed Size" Click="FixedSize_Click" />
                <MenuItem Header="Fixed Size Settings..." Click="FixedSizeSettings_Click" />
                <Separator />
                <MenuItem x:Name="DoublePageMenuItem" IsCheckable="True" InputGestureText="D" Click="DoublePage_Click" />
                <MenuItem x:Name="MangaModeMenuItem" IsCheckable="True" InputGestureText="M" Click="MangaMode_Click" />
                <Separator />
                <MenuItem x:Name="PdfCoverMenuItem" Header="PDF: Cover Alone" IsCheckable="True" Click="PdfCover_Click" />
                <MenuItem x:Name="PdfRotatePageMenuItem" Header="PDF: Rotate Page Clockwise" Click="PdfRotatePage_Click" />
                <MenuItem x:Name="PdfRotateAllMenuItem" Header="PDF: Rotate All Pages Clockwise" Click="PdfRotateAll_Click" />
                <MenuItem x:Name="PdfContinuousMenuItem" Header="PDF: Continuous Scroll" IsCheckable="True" Click="PdfContinuous_Click" />
                <MenuItem x:Name="PdfAutoCropMenuItem" Header="PDF: Auto-Crop White Margins" IsCheckable="True" Click="PdfAutoCrop_Click" />
                <MenuItem x:Name="StretchMenuItem" IsCheckable="True" InputGestureText="Y" Click="Stretch_Click" />
                <MenuItem x:Name="ThumbnailSidebarMenuItem" IsCheckable="True" Click="ThumbnailSidebar_Click" />
                <Separator />
                <MenuItem x:Name="FullscreenMenuItem" InputGestureText="F / F11" Click="Fullscreen_Click" />
                <Separator />
                <MenuItem Header="PDF Search" InputGestureText="Ctrl+F" Click="PdfSearch_Click" />
                <MenuItem Header="Go to Page" InputGestureText="G" Click="PdfGoTo_Click" />
                <MenuItem Header="PDF Properties" Click="PdfProperties_Click" />
            </MenuItem>
            <MenuItem x:Name="BookmarksMenu">
                <MenuItem x:Name="AddBookmarkMenuItem" InputGestureText="Ctrl+D" Click="AddBookmark_Click" />
                <MenuItem x:Name="EditBookmarksMenuItem" InputGestureText="Ctrl+B" Click="EditBookmarks_Click" />
            </MenuItem>
        </Menu>

        <ToolBarTray x:Name="MainToolbarTray" DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="PreviousToolbarButton" Content="◀" Click="Previous_Click" />
                <Button x:Name="NextToolbarButton" Content="▶" Click="Next_Click" />
                <Separator />
                <Button x:Name="BestFitToolbarButton" Click="BestFit_Click" />
                <Button x:Name="FitWidthToolbarButton" Click="FitWidth_Click" />
                <Button x:Name="FitHeightToolbarButton" Click="FitHeight_Click" />
                <Separator />
                <Button x:Name="DoublePageToolbarButton" Content="2p" Click="DoublePage_Click" />
                <Button x:Name="MangaToolbarButton" Click="MangaMode_Click" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Padding="2,0">
            <StatusBarItem Padding="8,0"><TextBlock x:Name="StatusText" /></StatusBarItem>
            <Border Width="1" Height="16" Margin="8,0" Background="#2B78A6" VerticalAlignment="Center" />
            <StatusBarItem Padding="8,0"><TextBlock x:Name="PageMetricsText" /></StatusBarItem>
            <Border Width="1" Height="16" Margin="8,0" Background="#2B78A6" VerticalAlignment="Center" />
            <StatusBarItem Padding="8,0"><TextBlock x:Name="BookNameText" MaxWidth="260" TextTrimming="CharacterEllipsis" /></StatusBarItem>
            <Border Width="1" Height="16" Margin="8,0" Background="#2B78A6" VerticalAlignment="Center" />
            <StatusBarItem Padding="8,0"><TextBlock x:Name="PageNameText" MaxWidth="320" TextTrimming="CharacterEllipsis" /></StatusBarItem>
            <Border Width="1" Height="16" Margin="8,0" Background="#2B78A6" VerticalAlignment="Center" />
            <StatusBarItem Padding="8,0"><TextBlock x:Name="FileSizeText" /></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ThumbnailColumn" Width="96" />
                <ColumnDefinition x:Name="ThumbnailSplitterColumn" Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ThumbnailSidebar"
                    Grid.Column="0"
                    Background="#1B1B1B"
                    BorderBrush="#3A3A3A"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,4">
                        <Button x:Name="PdfThumbnailTabButton" Content="Thumbnails" Click="PdfThumbnailTab_Click" Padding="5,2" />
                        <Button x:Name="PdfOutlineTabButton" Content="Contents" Visibility="Collapsed" Click="PdfOutlineTab_Click" Padding="5,2" />
                        <TextBlock x:Name="ThumbnailsTitle" Visibility="Collapsed" />
                    </StackPanel>
                    <Grid>
                    <ListBox x:Name="ThumbnailList"
                             SelectionChanged="ThumbnailList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Loaded="ThumbnailItem_Loaded"
                                        Margin="2"
                                        Padding="2"
                                        Background="#242424"
                                        CornerRadius="3">
                                    <StackPanel>
                                        <Border Background="#0D0D0D" MinHeight="48">
                                            <Image Source="{Binding Image}"
                                                   MaxHeight="96"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Text="{Binding PageLabel}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"
                                                   Foreground="#E6E6E6" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TreeView x:Name="PdfOutlineTree" Visibility="Collapsed"
                              SelectedItemChanged="PdfOutlineTree_SelectedItemChanged"
                              Background="#1B1B1B" Foreground="White" BorderThickness="0" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="ThumbnailSplitter"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#333333"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          DragCompleted="ThumbnailSplitter_DragCompleted" />

            <Grid Grid.Column="2">
                <controls:PageViewport x:Name="Viewport"
                                       MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                                       MouseMove="Viewport_MouseMove"
                                       MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                                       LostMouseCapture="Viewport_LostMouseCapture"
                                       SizeChanged="Viewport_SizeChanged">
                    <controls:PageViewport.ContextMenu>
                        <ContextMenu Opened="ViewportContextMenu_Opened">
                            <MenuItem Tag="PreviousPage" InputGestureText="PageUp" Click="Previous_Click" />
                            <MenuItem Tag="NextPage" InputGestureText="PageDown" Click="Next_Click" />
                            <Separator />
                            <MenuItem Tag="PreviousArchive" InputGestureText="Ctrl+Shift+P" Click="PreviousArchive_Click" />
                            <MenuItem Tag="NextArchive" InputGestureText="Ctrl+Shift+N" Click="NextArchive_Click" />
                            <Separator />
                            <MenuItem Tag="BestFit" IsCheckable="True" InputGestureText="B" Click="BestFit_Click" />
                            <MenuItem Tag="FitWidth" IsCheckable="True" InputGestureText="W" Click="FitWidth_Click" />
                            <MenuItem Tag="FitHeight" IsCheckable="True" InputGestureText="H" Click="FitHeight_Click" />
                            <MenuItem Tag="Manual" IsCheckable="True" InputGestureText="A" Click="Manual_Click" />
                            <MenuItem Tag="FixedSize" Header="Fixed Size" InputGestureText="S" IsCheckable="True" Click="FixedSize_Click" />
                            <MenuItem Header="Fixed Size Settings..." Click="FixedSizeSettings_Click" />
                            <Separator />
                            <MenuItem Tag="DoublePage" IsCheckable="True" InputGestureText="D" Click="DoublePage_Click" />
                            <MenuItem Tag="MangaMode" IsCheckable="True" InputGestureText="M" Click="MangaMode_Click" />
                            <MenuItem Tag="Stretch" IsCheckable="True" InputGestureText="Y" Click="Stretch_Click" />
                            <MenuItem Tag="Thumbnails" IsCheckable="True" Click="ThumbnailSidebar_Click" />
                            <Separator />
                            <MenuItem Tag="AddBookmark" InputGestureText="Ctrl+D" Click="AddBookmark_Click" />
                            <MenuItem Tag="Fullscreen" InputGestureText="F / F11" Click="Fullscreen_Click" />
                        </ContextMenu>
                    </controls:PageViewport.ContextMenu>
                </controls:PageViewport>
                <ListBox x:Name="PdfContinuousList" Visibility="Collapsed"
                         SizeChanged="PdfContinuousList_SizeChanged"
                         ScrollViewer.ScrollChanged="PdfContinuousList_ScrollChanged"
                         PreviewMouseLeftButtonDown="PdfContinuousPan_Down"
                         PreviewMouseMove="PdfContinuousPan_Move"
                         PreviewMouseLeftButtonUp="PdfContinuousPan_Up"
                         LostMouseCapture="PdfContinuousPan_LostCapture"
                         Background="#282828" BorderThickness="0"
                         Foreground="White"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingStackPanel.CleanUpVirtualizedItem="PdfContinuous_Cleanup"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="#282828"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <!-- Disable the default selected/hover colors; the
                                 PDF itself remains the only visual content. -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalAlignment="Center"
                                                          Margin="0"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Loaded="PdfContinuousRow_Loaded" Margin="0" BorderThickness="0"
                                    Background="#282828">
                                <StackPanel Orientation="Horizontal">
                                    <Grid>
                                        <Image Source="{Binding FirstImage}" Width="{Binding FirstWidth}"
                                               Height="{Binding FirstHeight}" Stretch="Fill"
                                               Tag="{Binding FirstPage}"
                                               />
                                        <ItemsControl ItemsSource="{Binding FirstHighlights}"
                                                      IsHitTestVisible="False"
                                                      Width="{Binding FirstWidth}" Height="{Binding FirstHeight}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#6670AAFA"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <Grid>
                                        <Image Source="{Binding SecondImage}" Width="{Binding SecondWidth}"
                                               Height="{Binding SecondHeight}" Stretch="Fill"
                                               Tag="{Binding SecondPage}"
                                               />
                                        <ItemsControl ItemsSource="{Binding SecondHighlights}"
                                                      IsHitTestVisible="False"
                                                      Width="{Binding SecondWidth}" Height="{Binding SecondHeight}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#6670AAFA"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
